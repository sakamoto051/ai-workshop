diff --git a/src/auth/utils.py b/src/auth/utils.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/auth/utils.py
@@ -0,0 +1,8 @@
+import hmac
+
+def constant_time_compare(a: str, b: str) -> bool:
+    """タイミング攻撃を防ぐための定数時間比較。"""
+    return hmac.compare_digest(a.encode(), b.encode())

